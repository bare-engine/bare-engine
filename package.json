{
  "name": "bare-engine",
  "version": "0.1.0",
  "scripts": {
    "build": "node scripts/cleanDist.cjs && vite build",
    "analyze": "vite build",
    "dev:fixture": "node scripts/devFixture.cjs",
    "test": "node scripts/runTests.cjs",
    "test:e2e": "npm run test"
  },
  "description": "Bare Game Engine - Build for Web",
  "license": "MIT",
  "files": [
    "config",
    "src",
    "vite",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "./src/main.ts",
    "./src/controllers/*.ts",
    "./src/handlers/cameraHandler.ts",
    "./src/handlers/levelHandler.ts",
    "./src/libraries/howler/howler.core.js"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./config/vite.config": "./config/vite.config.cjs",
    "./config/vite.config.cjs": "./config/vite.config.cjs",
    "./config/tsconfig.base.json": "./config/tsconfig.base.json",
    "./vite/*": "./vite/*"
  },
  "peerDependencies": {
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.5"
  },
  "dependencies": {
    "selenium-webdriver": "^4.43.0"
  }
}
