{
  "name": "bare-engine",
  "version": "0.1.0",
  "scripts": {
    "analyze": "webpack --config webpack.config.js --env analyze --json=stats.json && webpack-bundle-analyzer stats.json",
    "dev:fixture": "node scripts/devFixture.cjs",
    "test": "node scripts/runTests.cjs",
    "test:e2e": "npm run test"
  },
  "description": "Bare Game Engine - Build for Web",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "sideEffects": [
    "./src/main.ts"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "devDependencies": {
    "@cucumber/cucumber": "^12.8.2",
    "@types/node": "^25.1.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "selenium-webdriver": "^4.43.0"
  }
}
