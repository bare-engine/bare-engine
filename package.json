{
  "name": "bare-engine",
  "version": "0.1.0",
  "scripts": {
    "analyze": "webpack --config webpack.config.js --env analyze --json=stats.json && webpack-bundle-analyzer stats.json"
  },
  "description": "Bare Game Engine - Build for Web",
  "license": "MIT",
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ],
  "main": "src/exports/index.ts",
  "types": "index.d.ts",
  "sideEffects": [
    "./src/main.ts"
  ],
  "exports": {
    ".": {
      "types": "./typeDefs/index.d.ts",
      "default": "./src/exports/index.ts"
    },
    "./core": {
      "types": "./typeDefs/core.d.ts",
      "default": "./src/exports/core.ts"
    },
    "./sound": {
      "types": "./typeDefs/sound.d.ts",
      "default": "./src/exports/sound.ts"
    },
    "./barePhysics": {
      "types": "./typeDefs/barePhysics.d.ts",
      "default": "./src/exports/barePhysics.ts"
    },
    "./physics": {
      "types": "./typeDefs/physics.d.ts",
      "default": "./src/exports/physics.ts"
    },
    "./sopiroPhysics": {
      "types": "./typeDefs/sopiroPhysics.d.ts",
      "default": "./src/exports/sopiroPhysics.ts"
    },
    "./editor": {
      "types": "./typeDefs/editor.d.ts",
      "default": "./src/exports/editor.ts"
    }
  },
  "typesVersions": {
    "*": {
      "editor": [
        "typeDefs/editor.d.ts"
      ],
      "sound": [
        "typeDefs/sound.d.ts"
      ],
      "barePhysics": [
        "typeDefs/barePhysics.d.ts"
      ],
      "physics": [
        "typeDefs/physics.d.ts"
      ],
      "sopiroPhysics": [
        "typeDefs/sopiroPhysics.d.ts"
      ],
      "core": [
        "typeDefs/core.d.ts"
      ],
      "*": [
        "typeDefs/index.d.ts"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "webpack": "^5.104.1",
    "webpack-cli": "^6.0.1"
  }
}
