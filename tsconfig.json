{
  "compilerOptions": {
    "strict": false,
    "strictPropertyInitialization": false,
     "strictNullChecks": false,
     
    "target": "ES2020",
    "module": "ESNext",
    "outDir": "./dist/",
    "moduleResolution": "bundler",
    "paths": {
      "bare-engine": ["./src/index.ts"],
      "bare-engine/arcade": ["./src/arcade.ts"],
      "bare-engine/sopiro": ["./src/sopiro.ts"]
    },
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": ["src", "features/fixtures/src"],
  "exclude": ["node_modules", "**/*.spec.ts", "src/libraries/rapid-render"]
}
